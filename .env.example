LLM_PROVIDER=groq

STT_PROVIDER=groq
WHISPER_MODEL=small
INTENT_MODEL_DIR=models/indobert-intent
EMOTION_MODEL_DIR=models/indobert-emotion
TTS_PROVIDER=browser
PIPER_MODEL_PATH=models/tts/id_ID-news_tts-medium.onnx

