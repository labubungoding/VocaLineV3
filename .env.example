COMPOSE_PROFILES=tunnel

APP_URL=https://app.domain-anda.id

EXTRA_CORS_ORIGINS=

WEB_PORT=8088

POSTGRES_DB=vocaline
POSTGRES_USER=vocaline

POSTGRES_PASSWORD=
DATABASE_POOL_SIZE=10

ML_API_KEY=
ML_TIMEOUT=25s
HOSPITAL_TIMEZONE=Asia/Jakarta

HOSPITAL_ADAPTER=mock
SIMRS_BASE_URL=
SIMRS_API_KEY=
MAX_AUDIO_BYTES=2500000
LOG_LEVEL=info

CRON_SECRET=

SESSION_HOURS=12
INVITE_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=60

SUPERADMIN_ALLOWLIST=it@rumahsakit-anda.id

SMTP_HOST=

SMTP_PORT=587

SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_HELO_NAME=app.domain-anda.id

MAIL_FROM=no-reply@domain-anda.id
MAIL_FROM_NAME=VocaLine

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b,qwen/qwen3.8-27b
GEMINI_API_KEY=
